rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email is string &&
        (
          request.auth.token.email == 'love.dotk@gmail.com' ||
          (
            exists(/databases/$(database)/documents/adminEmailsV2/$(request.auth.token.email)) &&
            get(/databases/$(database)/documents/adminEmailsV2/$(request.auth.token.email)).data.enabled == true
          )
        );
    }

    match /adminEmailsV2/{email} {
      allow read: if request.auth != null &&
        request.auth.token.email == email;
      allow write: if false;
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;

      match /customChoicesV2/{choiceId} {
        allow read, write: if false;
      }
    }

    match /duelsV2/{duelId} {
      allow read: if request.auth != null &&
        (resource.data.p1Uid == request.auth.uid ||
         resource.data.p2Uid == request.auth.uid);
      allow write: if false;
    }

    match /cardsV2/{cardId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();

      match /questions/{questionId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /botRoundsV2/{roundId} {
      allow read, write: if false;
    }

    match /duelSecretsV2/{duelId} {
      allow read, write: if false;
    }

    match /matchQueueV2/{queueId} {
      allow read, write: if false;
    }

    match /weeklyRankingV2/{weekKey} {
      allow read, write: if false;
      match /players/{userId} {
        allow read, write: if false;
      }
    }

    match /rankingRewardsV2/{rewardId} {
      allow read, write: if false;
    }

    match /purchaseEntitlementsV2/{entitlementId} {
      allow read, write: if false;
    }

    match /purchaseReceiptClaimsV2/{claimId} {
      allow read, write: if false;
    }

    match /adminAuditV2/{entryId} {
      allow read, write: if false;
    }
  }
}
