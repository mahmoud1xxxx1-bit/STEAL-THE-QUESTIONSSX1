rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /duels/{duelId} {
      allow read: if request.auth != null &&
        (resource.data.p1Uid == request.auth.uid ||
         resource.data.p2Uid == request.auth.uid);
      allow write: if false;
    }

    match /duelsV2/{duelId} {
      allow read: if request.auth != null &&
        (resource.data.p1Uid == request.auth.uid ||
         resource.data.p2Uid == request.auth.uid);
      allow write: if false;
    }

    match /cardsV2/{cardId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /questions/{questionId} {
        allow read, write: if false;
      }
    }

    match /botRounds/{roundId} {
      allow read, write: if false;
    }

    match /botRoundsV2/{roundId} {
      allow read, write: if false;
    }

    match /duelSecrets/{duelId} {
      allow read, write: if false;
    }

    match /duelSecretsV2/{duelId} {
      allow read, write: if false;
    }

    match /matchQueue/{queueId} {
      allow read, write: if false;
    }

    match /matchQueueV2/{queueId} {
      allow read, write: if false;
    }

    match /rankingRewards/{rewardId} {
      allow read, write: if false;
    }

    match /rankingRewardsV2/{rewardId} {
      allow read, write: if false;
    }

    match /purchaseEntitlements/{entitlementId} {
      allow read, write: if false;
    }

    match /purchaseEntitlementsV2/{entitlementId} {
      allow read, write: if false;
    }
  }
}
